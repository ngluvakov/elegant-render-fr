# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Auth.js ──────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxx

# ─── PayPal ───────────────────────────────────────────────
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxxxx

# ─── Bitrix24 ────────────────────────────────────────────
BITRIX24_WEBHOOK_URL=https://yourportal.bitrix24.com/rest/1/token/
BITRIX24_OUTBOUND_SECRET=your-outbound-webhook-token
BITRIX24_PIPELINE_ID=3
BITRIX24_STAGE_DRAFT=C3:NEW
BITRIX24_STAGE_AWAITING_PAYMENT=C3:AWAITING_PAYMENT
BITRIX24_STAGE_PAID=C3:PAID
BITRIX24_STAGE_IN_PROGRESS=C3:IN_PROGRESS
BITRIX24_STAGE_IN_REVIEW=C3:IN_REVIEW
BITRIX24_STAGE_REVISION_REQUESTED=C3:REVISION
BITRIX24_STAGE_DELIVERED=C3:DELIVERED
BITRIX24_STAGE_CLOSED=C3:CLOSED
BITRIX24_STAGE_CANCELLED=C3:CANCELLED
BITRIX24_STAGE_REFUNDED=C3:REFUNDED
CRON_SECRET=your-cron-secret

# ─── Email (Resend) ──────────────────────────────────────
# Get key at https://resend.com/api-keys (verify a sending domain first).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Elegant Render <noreply@elegantrender.rs>
ADMIN_NOTIFY_EMAIL=info@elegantrender.rs

# ─── Sentry (error tracking + tracing + session replay) ──
# DSN strings from sentry.io/settings/projects/<project>/keys/.
# Client-side DSN must be NEXT_PUBLIC_ to ship in browser bundle;
# server-side DSN stays server-only.
SENTRY_DSN=https://xxxxx@oxxx.ingest.de.sentry.io/xxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oxxx.ingest.de.sentry.io/xxxxxxx

# Build-time auth token for source map upload (.env.sentry-build-plugin
# is gitignored; Vercel sets this in Production + Preview env). Without
# it, Sentry stack traces show minified code instead of TypeScript.
# Generate at https://sentry.io/settings/auth-tokens/ with scopes
# project:releases + org:read.
# SENTRY_AUTH_TOKEN=sntrys_xxxxx

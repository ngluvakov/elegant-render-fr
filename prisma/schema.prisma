generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models ─────────────────────────────

model User {
  id                        String    @id @default(cuid())
  name                      String?
  email                     String    @unique
  emailVerified             DateTime?
  image                     String?
  passwordHash              String?
  phone                     String?
  isAdmin                   Boolean   @default(false)
  canManageFinance          Boolean   @default(false)
  bitrixContactId           String?   @unique
  aiCreditBalanceUnits      Int       @default(0)
  aiCreditsExpireAt         DateTime?
  aiCreditsReminder30SentAt DateTime?
  aiCreditsReminder7SentAt  DateTime?
  // GDPR Art. 17 erasure request. Set when the user clicks "Obriši
  // nalog" in the profile; admin reconciles within 30 days. Hard
  // deletion is constrained by the Zakon o računovodstvu 10-year
  // invoice retention rule, so processing is anonymization, not row
  // delete. Field is null for the vast majority of users.
  deletionRequestedAt       DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  orders               Order[]
  comments             OrderComment[]
  aiCreditTransactions AiCreditTransaction[]
  aiGenerations        AiGeneration[]
  chatFeedback         ChatFeedback[]
  projectInquiries     ProjectInquiry[]
  chargesRequested     OrderCharge[]         @relation("OrderChargeRequestedBy")
  pricingBooksCreated  PricingBook[]         @relation("PricingBookCreatedBy")
  pricingBooksPublished PricingBook[]        @relation("PricingBookPublishedBy")
  pricingChangeLogs    PricingChangeLog[]    @relation("PricingChangeLogActor")
  auditLogs            AuditLog[]            @relation("AuditLogActor")

  @@map("users")
}

/// Forensically-stable record of consequential admin and system actions.
/// Required by ISO 27001:2022 control set (A.8.15 Logging) and by GDPR
/// Art. 32 (security of processing). Inserted by recordAuditLog() in
/// src/lib/audit.ts; failure to log never breaks the underlying action.
///
/// actorEmail is captured at log time even though we have a relation —
/// when a user is deleted we want the trail to remain readable.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String?
  action     String
  entityType String?
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
  @@map("audit_logs")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Order models ────────────────────────────────────────

enum OrderStatus {
  draft
  awaiting_payment
  paid
  in_progress
  in_review
  revision_requested
  delivered
  closed
  cancelled
  refunded
}

/// Tip kupca za potrebe izdavanja računa.
/// - `individual`     fizičko lice (B2C) — fiskalni račun preko ESIR-a
/// - `company_rs`     privredno društvo u Srbiji — e-faktura kroz SEF
/// - `company_foreign` strana firma — PDF faktura, oslobođenje od PDV-a
enum BuyerType {
  individual
  company_rs
  company_foreign
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentProvider {
  paypal
  card_mock
  wire_transfer
}

/// How the customer is expected to pay this order.
/// - `online_payment` (default): card / PayPal at checkout. Konačni račun
///   issued automatically by finishSuccessfulPayment hook.
/// - `wire_transfer`: admin-issued offer flow. Predračun (proforma) is
///   sent to customer; once funds land, admin marks paid → triggers
///   the same finishSuccessfulPayment → konačni račun pipeline.
enum PaymentMethod {
  online_payment
  wire_transfer
}

model Order {
  id                 String           @id @default(cuid())
  orderNumber        String           @unique
  userId             String
  projectName        String?
  status             OrderStatus      @default(draft)
  paymentStatus      PaymentStatus    @default(pending)
  paymentProvider    PaymentProvider?
  paymentId          String?
  bitrix24DealId     String?          @unique
  totalEur           Int
  totalCents         Int?
  premiumTotalEur    Int?
  containsAiCredits  Boolean          @default(false)
  aiCreditsAppliedAt DateTime?
  customerNote       String?          @db.Text
  // Customer's explicit waiver of the 14-day distance-selling withdrawal
  // right per Zakon o zaštiti potrošača čl. 28 / EU CRD čl. 16(m).
  // Required for digital services started before the 14-day period
  // elapses; null means the right is still active and the order
  // shouldn't have started production yet.
  withdrawalWaivedAt DateTime?
  // Buyer identity for invoicing. Defaults to `individual` so existing
  // and untouched orders behave as before. company_* values are only
  // populated when the customer explicitly chose "Firma" in checkout
  // and provided the legally-required fields. Reading these:
  //   companyTaxId  — PIB for company_rs, VAT ID / local tax ID for
  //                   company_foreign (interpret via companyCountryCode).
  //   companyMb     — matični broj, only meaningful for company_rs.
  //   companyCountryCode — ISO-3166-1 alpha-2; null for individual.
  buyerType          BuyerType        @default(individual)
  companyName        String?
  companyTaxId       String?
  companyMb          String?
  companyAddress     String?          @db.Text
  companyCountryCode String?
  // VIES (VAT Information Exchange System) verification snapshot for
  // company_foreign orders. Populated when admin clicks "Proveri VAT
  // (VIES)" on the order detail. Stored as a snapshot — VIES queries
  // are point-in-time and the EU REST result includes a requestId we
  // keep as forensic proof of when the check ran.
  //   vatVerifiedAt    — when the lookup succeeded (null = not checked)
  //   vatVerifiedName  — name returned by VIES at lookup time. May
  //                      diverge from companyName if customer mistyped.
  //   vatRequestId     — VIES requestId, retained for audit/dispute use
  vatVerifiedAt      DateTime?
  vatVerifiedName    String?
  vatRequestId       String?
  // Invoice issuance — populated once, immediately after the payment
  // provider confirms `paymentStatus = completed`. invoiceNumber is
  // allocated atomically per calendar year via InvoiceCounter and is
  // unique across all orders (no gaps within a year). invoicePdfPath
  // is the Supabase storage path under bucket `order-files`, format
  // `invoices/{year}/{number}.pdf`.
  invoiceNumber      String?          @unique
  invoiceIssuedAt    DateTime?
  invoicePdfPath     String?
  paymentMethod      PaymentMethod    @default(online_payment)
  // Predračun (proforma) issuance — populated when admin clicks
  // "Izdaj predračun" on a wire_transfer order. The proforma is NOT
  // a tax document; it's a payment instruction. The legal konačni
  // račun is created later via the existing invoice pipeline once
  // funds land. Format `P-{year}-{seq}` (e.g. P-2026-0001).
  proformaNumber     String?          @unique
  proformaIssuedAt   DateTime?
  proformaPdfPath    String?
  // Rule 3: reference a prior paid order so its model assets feed
  // discount resolution on this order. Nullable; enforced same-user via
  // server action.
  referencedOrderId  String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  files             OrderFile[]
  statusEvents      OrderStatusEvent[]
  comments          OrderComment[]
  charges           OrderCharge[]
  referencedOrder   Order?             @relation("OrderReference", fields: [referencedOrderId], references: [id])
  referencingOrders Order[]            @relation("OrderReference")

  @@map("orders")
}

model OrderItem {
  id               String        @id @default(cuid())
  orderId          String
  productId        String
  categoryId       String
  productLabel     String
  categoryLabel    String
  kind             OrderItemKind @default(service)
  basePriceEur     Int
  basePriceCents   Int?
  totalEur         Int
  totalCents       Int?
  aiCreditQuantity Int?
  aiCreditUnits    Int?
  addOnsJson       Json
  durationSeconds  Int?
  durationDiscount Float?
  clientNote       String?       @db.Text
  configJson       Json?
  originalTotalEur Int?
  discountPct      Int?
  discountReason   String?       @db.Text

  order Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  files OrderFile[]

  @@map("order_items")
}

enum OrderItemKind {
  service
  ai_credits
}

model OrderFile {
  id             String   @id @default(cuid())
  orderId        String
  orderItemId    String?
  floorId        String?
  kind           String   @default("source")
  fileName       String
  fileSize       Int
  mimeType       String
  storagePath    String
  bitrix24FileId String?
  uploadedAt     DateTime @default(now())
  // Antivirus scan state. ISO 27001 control A.8.7. Synchronously
  // scanned at upload-confirm time via Cloudmersive; rows are only
  // created when the scan returns clean. Pre-scan-era rows have null
  // values. scanThreats stays empty for clean rows; populated when an
  // older flow stored an infected file (defense in depth, not used by
  // current pipeline since infected uploads never reach the DB).
  scanStatus     String?
  scannedAt      DateTime?
  scanThreats    String[]

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@map("order_files")
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.Text
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderComment {
  id                String   @id @default(cuid())
  orderId           String
  authorId          String
  role              String   @default("client")
  body              String   @db.Text
  bitrix24CommentId String?  @unique
  createdAt         DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_comments")
}

// ─── Ad-hoc additional charges ──────────────────────────
//
// Out-of-scope work after the original order is paid: a forgotten
// service, an extra room, an edit beyond the included revisions, or
// any custom item negotiated by phone/email. Modeled separately from
// Order because Order.totalCents is immutable (the PayPal capture
// path relies on the locked-in amount for idempotency). Each charge
// gets its own payment lifecycle; the customer pays through the same
// providers as the original checkout.

enum OrderChargeStatus {
  pending
  paid
  cancelled
}

model OrderCharge {
  id              String            @id @default(cuid())
  orderId         String
  requestedById   String
  reason          String?           @db.Text
  totalCents      Int
  status          OrderChargeStatus @default(pending)
  paymentProvider PaymentProvider?
  paymentId       String?
  paymentStatus   PaymentStatus     @default(pending)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  paidAt          DateTime?
  cancelledAt     DateTime?

  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  requestedBy User              @relation("OrderChargeRequestedBy", fields: [requestedById], references: [id])
  items       OrderChargeItem[]

  @@index([orderId, status])
  @@map("order_charges")
}

model OrderChargeItem {
  id          String  @id @default(cuid())
  chargeId    String
  productId   String?
  kind        String
  label       String
  amountCents Int
  quantity    Int     @default(1)
  configJson  Json?

  charge OrderCharge @relation(fields: [chargeId], references: [id], onDelete: Cascade)

  @@index([chargeId])
  @@map("order_charge_items")
}

// ─── Bitrix24 sync log ───────────────────────────────────

model BitrixSyncLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  direction   String
  method      String
  payloadHash String?
  bitrixId    String?
  success     Boolean  @default(true)
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([direction, createdAt])
  @@map("bitrix_sync_logs")
}

// ─── Saved / shared quotes ───────────────────────────────
//
// A `Quote` is a snapshot of a /cene configurator session that the
// customer chose to save before paying. The id is the share token; the
// URL is /cene?q=<id>. Items are stored as the same QuoteItem[] shape
// the configurator works with, so loading rehydrates the cart 1:1.
// Expires after 30 days unless reopened.

model Quote {
  id        String    @id @default(cuid())
  itemsJson Json
  userId    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  openedAt  DateTime?

  @@index([expiresAt])
  @@map("quotes")
}

// ─── AI Studio credits and generations ───────────────────

enum AiCreditTransactionType {
  purchase
  spend
  refund
  expiry
  adjustment
}

enum AiGenerationStatus {
  queued
  processing
  completed
  failed
}

enum AiEditType {
  item_removal
  day_to_dusk
  sky_replacement
  wall_color_change
  virtual_staging
  virtual_renovation
  room_redesign
}

enum AiImageProvider {
  gemini_flash
  gemini_pro
  openai
}

model AiCreditTransaction {
  id                String                  @id @default(cuid())
  userId            String
  orderId           String?
  generationId      String?
  type              AiCreditTransactionType
  units             Int
  balanceAfterUnits Int
  amountCents       Int?
  note              String?                 @db.Text
  createdAt         DateTime                @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([orderId])
  @@index([generationId])
  @@map("ai_credit_transactions")
}

model AiGeneration {
  id                  String             @id @default(cuid())
  userId              String
  parentGenerationId  String?
  paidGenerationId    String?
  editType            AiEditType
  provider            AiImageProvider
  model               String
  prompt              String             @db.Text
  styleId             String?
  optionsJson         Json?
  status              AiGenerationStatus @default(queued)
  inputStoragePath    String
  inputMimeType       String
  maskStoragePath     String?
  resultStoragePath   String?
  resultMimeType      String?
  // Filename tracking — propagated through derivative chains so
  // downloads carry meaningful names tied to the original upload.
  // `rootFileName` is the slugified original-upload name; it stays
  // constant when a result is reused as the input of a new gen.
  // `inputFileName` is the literal name of the file used as input
  // for THIS gen (= parent's resultFileName for derivatives).
  // `resultFileName` is computed deterministically at create time:
  // `{rootBase}__{editTypeCode}__v{NN}__{YYYYMMDD}.{ext}`.
  rootFileName        String?
  inputFileName       String?
  resultFileName      String?
  unitsCharged        Int
  coveredUnits        Int
  freeAttemptIndex    Int?
  errorMessage        String?            @db.Text
  providerResponseId  String?
  expiresAt           DateTime
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  startedAt           DateTime?
  completedAt         DateTime?
  processingLockUntil DateTime?
  attemptCount        Int                @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([paidGenerationId, freeAttemptIndex])
  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([status, createdAt])
  @@index([paidGenerationId])
  @@index([processingLockUntil])
  @@map("ai_generations")
}

// ─── Chat feedback ───────────────────────────────────────

model ChatFeedback {
  id               String   @id @default(cuid())
  userId           String?
  sessionId        String?
  pagePath         String?
  category         String
  status           String   @default("new")
  messageExcerpt   String   @db.Text
  body             String   @db.Text
  conversationJson Json?
  createdAt        DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([category, createdAt])
  @@index([userId, createdAt])
  @@map("chat_feedback")
}

// ─── General project inquiries ───────────────────────────
//
// Pre-sales intake for visitors who do not want to finish the self-serve
// configurator. These records are CRM leads, not orders; the team reviews
// the brief and sends a proposal manually from email/Bitrix.

enum ProjectInquiryStatus {
  pending
  in_progress
  proposal_sent
  converted
  closed
}

model ProjectInquiry {
  id                String               @id @default(cuid())
  source            String?
  sourcePath        String?
  sourceLabel       String?
  contactName       String
  email             String
  phone             String?
  company           String?
  serviceType       String?
  budget            String?
  deadline          String?
  message           String               @db.Text
  quoteSnapshotJson Json?
  userId            String?
  status            ProjectInquiryStatus @default(pending)
  bitrixLeadId      String?              @unique
  bitrixSyncError   String?              @db.Text
  bitrixSyncedAt    DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  reviewedAt        DateTime?

  user  User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  files ProjectInquiryFile[]

  @@index([status, createdAt])
  @@index([email, createdAt])
  @@map("project_inquiries")
}

model ProjectInquiryFile {
  id          String   @id @default(cuid())
  inquiryId   String
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String   @unique
  uploadedAt  DateTime @default(now())
  // Antivirus scan state — see OrderFile for semantics. Same scan
  // pipeline runs before submitProjectInquiry creates rows; an
  // infected file fails the whole inquiry submission.
  scanStatus  String?
  scannedAt   DateTime?
  scanThreats String[]

  inquiry ProjectInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
  @@map("project_inquiry_files")
}

// ─── Versioned pricing catalog ───────────────────────────
//
// EUR excluding VAT is the financial source of truth. Published books
// feed public pricing, checkout, portal repricing, admin charges and AI
// credit purchases. Draft books are editable by finance admins only and
// do not affect live pricing until published.

enum PricingBookStatus {
  draft
  published
  archived
}

model PricingBook {
  id            String            @id @default(cuid())
  name          String
  status        PricingBookStatus @default(draft)
  catalogJson   Json
  settingsJson  Json
  createdById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  createdBy   User?               @relation("PricingBookCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  publishedBy User?               @relation("PricingBookPublishedBy", fields: [publishedById], references: [id], onDelete: SetNull)
  products    PricingProduct[]
  addOns      PricingAddOn[]
  discounts   PricingDiscountRule[]
  durations   PricingDurationRule[]
  settings    PricingSetting[]
  changeLogs  PricingChangeLog[]

  @@index([status, publishedAt])
  @@map("pricing_books")
}

model PricingProduct {
  id           String   @id @default(cuid())
  bookId       String
  productId    String
  categoryId   String
  label        String
  unitLabel    String
  basePriceEur Float
  includesJson Json
  inquiryOnly  Boolean  @default(false)
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt

  book PricingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, productId])
  @@index([bookId, categoryId])
  @@map("pricing_products")
}

model PricingAddOn {
  id             String   @id @default(cuid())
  bookId         String
  productId      String
  addOnId        String
  label          String
  description    String
  priceEur       Float
  priceType      String
  includedQty    Int
  maxQty         Int?
  volumeRulesJson Json
  sortOrder      Int      @default(0)
  updatedAt      DateTime @updatedAt

  book PricingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, productId, addOnId])
  @@index([bookId, productId])
  @@map("pricing_add_ons")
}

model PricingDiscountRule {
  id                 String   @id @default(cuid())
  bookId             String
  ruleId             String
  productId          String
  requires           String
  discountPct        Int
  reason             String
  conditionJson      Json?
  sourceProductsJson Json?
  sortOrder          Int      @default(0)
  updatedAt          DateTime @updatedAt

  book PricingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, ruleId])
  @@index([bookId, productId])
  @@map("pricing_discount_rules")
}

model PricingDurationRule {
  id                String   @id @default(cuid())
  bookId            String
  productId         String
  sourceMode        String?
  minSeconds        Int
  defaultSeconds    Int
  maxSeconds        Int?
  perSecondEur      Float
  discountTiersJson Json
  updatedAt         DateTime @updatedAt

  book PricingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, productId, sourceMode])
  @@index([bookId, productId])
  @@map("pricing_duration_rules")
}

model PricingSetting {
  id        String   @id @default(cuid())
  bookId    String
  key       String
  valueJson Json
  updatedAt DateTime @updatedAt

  book PricingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, key])
  @@map("pricing_settings")
}

model PricingChangeLog {
  id        String   @id @default(cuid())
  bookId    String
  actorId   String?
  action    String
  detailsJson Json?
  createdAt DateTime @default(now())

  book  PricingBook @relation(fields: [bookId], references: [id], onDelete: Cascade)
  actor User?       @relation("PricingChangeLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([bookId, createdAt])
  @@index([actorId, createdAt])
  @@map("pricing_change_logs")
}

// ─── VR consultation inquiries ───────────────────────────
//
// VR products (vr-existing, vr-standalone) bypass the cart/payment flow
// entirely — too premium and scope-dependent for self-serve. Customers
// fill an intake form on /usluge/vr/konsultacija that captures the same
// VrConfig shape used by the per-item configurator, plus contact info.
// The team reviews the inquiry, holds a meeting, and creates the actual
// order manually with a custom quote.

enum VrInquiryStatus {
  pending // submitted, awaiting team review
  in_progress // team has contacted customer
  converted // customer's project became an Order
  closed // customer didn't proceed
}

// ─── Transactional outbox ───────────────────────────────
//
// Side effects that we MUST NOT lose if a transient failure happens —
// transactional emails (order confirmation, portal access, VR project
// ready) and any future critical webhook deliveries — are written
// here in the same transaction as the trigger event. A separate cron
// processor picks them up, runs the handler, and marks the row.
//
// `idempotencyKey` is a deterministic string per event (e.g.
// "order_confirmation:<orderId>"). The unique constraint guarantees
// a producer can't enqueue the same event twice; the processor uses
// (status, nextAttemptAt) to find work and updates row state to
// claim → succeed or back off.

enum OutboxEventStatus {
  pending // newly enqueued or scheduled to retry
  running // processor has claimed this row, in-flight
  succeeded // handler completed successfully
  failed // exceeded maxAttempts; needs human intervention
}

enum OutboxEventType {
  order_confirmation_email
  portal_access_email
  vr_project_ready_email
  ai_credits_expiry_reminder_email
  ai_credits_granted_email
  free_revision_granted_email
  additional_charge_requested_email
  additional_charge_paid_email
  invoice_issued_email
  proforma_issued_email
}

/// Atomic per-year invoice counter. One row per calendar year; the
/// row is upsert-incremented inside allocateInvoiceNumber() in
/// src/lib/invoice-number.ts. Concurrent calls on the same year row
/// serialize on the row's update lock so seq stays gap-free.
model InvoiceCounter {
  year      Int      @id
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("invoice_counters")
}

/// Atomic per-year proforma (predračun) counter. Same row-lock
/// serialization pattern as InvoiceCounter; numbers are issued as
/// `P-{year}-{seq}` so the prefix never collides with invoice
/// numbers and the accountant sees at a glance which document
/// type a number belongs to.
model ProformaCounter {
  year      Int      @id
  seq       Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("proforma_counters")
}

model OutboxEvent {
  id             String            @id @default(cuid())
  type           OutboxEventType
  payload        Json
  idempotencyKey String            @unique
  status         OutboxEventStatus @default(pending)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  succeededAt    DateTime?

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model VrInquiry {
  id               String          @id @default(cuid())
  productId        String // "vr-existing" | "vr-standalone"
  configJson       Json // sanitized VrConfig
  contactName      String
  email            String
  phone            String?
  message          String?         @db.Text
  userId           String? // set if a logged-in user submitted
  status           VrInquiryStatus @default(pending)
  // Set when an admin runs convertVrInquiryToOrder; references Order.id
  // without an FK so an order can be deleted without orphaning the
  // inquiry record.
  convertedOrderId String?
  createdAt        DateTime        @default(now())
  reviewedAt       DateTime?

  @@index([status, createdAt])
  @@map("vr_inquiries")
}

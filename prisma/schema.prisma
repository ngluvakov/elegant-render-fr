generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth.js required models ─────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  isAdmin         Boolean   @default(false)
  bitrixContactId String?   @unique
  createdAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  orders   Order[]
  comments OrderComment[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Order models ────────────────────────────────────────

enum OrderStatus {
  draft
  awaiting_payment
  paid
  in_progress
  in_review
  revision_requested
  delivered
  closed
  cancelled
  refunded
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum PaymentProvider {
  paypal
  card_mock
}

model Order {
  id              String          @id @default(cuid())
  orderNumber     String          @unique
  userId          String
  projectName     String?
  status          OrderStatus     @default(draft)
  paymentStatus   PaymentStatus   @default(pending)
  paymentProvider PaymentProvider?
  paymentId       String?
  bitrix24DealId  String?   @unique
  totalEur        Int
  customerNote    String?         @db.Text
  // Rule 3: reference a prior paid order so its model assets feed
  // discount resolution on this order. Nullable; enforced same-user via
  // server action.
  referencedOrderId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  files             OrderFile[]
  statusEvents      OrderStatusEvent[]
  comments          OrderComment[]
  referencedOrder   Order?             @relation("OrderReference", fields: [referencedOrderId], references: [id])
  referencingOrders Order[]            @relation("OrderReference")

  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productId        String
  categoryId       String
  productLabel     String
  categoryLabel    String
  basePriceEur     Int
  totalEur         Int
  addOnsJson       Json
  durationSeconds  Int?
  durationDiscount Float?
  clientNote       String? @db.Text
  configJson       Json?
  originalTotalEur Int?
  discountPct      Int?
  discountReason   String? @db.Text

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  files OrderFile[]

  @@map("order_items")
}

model OrderFile {
  id             String   @id @default(cuid())
  orderId        String
  orderItemId    String?
  floorId        String?
  kind           String   @default("source")
  fileName       String
  fileSize       Int
  mimeType       String
  storagePath    String
  bitrix24FileId String?
  uploadedAt     DateTime @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id])

  @@map("order_files")
}

model OrderStatusEvent {
  id         String       @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?      @db.Text
  actorId    String?
  createdAt  DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_status_events")
}

model OrderComment {
  id        String   @id @default(cuid())
  orderId   String
  authorId  String
  role               String   @default("client")
  body               String   @db.Text
  bitrix24CommentId  String?  @unique
  createdAt          DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_comments")
}

// ─── Bitrix24 sync log ───────────────────────────────────

model BitrixSyncLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  direction   String
  method      String
  payloadHash String?
  bitrixId    String?
  success     Boolean  @default(true)
  error       String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([direction, createdAt])
  @@map("bitrix_sync_logs")
}

// ─── Saved / shared quotes ───────────────────────────────
//
// A `Quote` is a snapshot of a /cene configurator session that the
// customer chose to save before paying. The id is the share token; the
// URL is /cene?q=<id>. Items are stored as the same QuoteItem[] shape
// the configurator works with, so loading rehydrates the cart 1:1.
// Expires after 30 days unless reopened.

model Quote {
  id        String    @id @default(cuid())
  itemsJson Json
  userId    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  openedAt  DateTime?

  @@index([expiresAt])
  @@map("quotes")
}

// ─── VR consultation inquiries ───────────────────────────
//
// VR products (vr-existing, vr-standalone) bypass the cart/payment flow
// entirely — too premium and scope-dependent for self-serve. Customers
// fill an intake form on /usluge/vr/konsultacija that captures the same
// VrConfig shape used by the per-item configurator, plus contact info.
// The team reviews the inquiry, holds a meeting, and creates the actual
// order manually with a custom quote.

enum VrInquiryStatus {
  pending      // submitted, awaiting team review
  in_progress  // team has contacted customer
  converted    // customer's project became an Order
  closed       // customer didn't proceed
}

// ─── Transactional outbox ───────────────────────────────
//
// Side effects that we MUST NOT lose if a transient failure happens —
// transactional emails (order confirmation, portal access, VR project
// ready) and any future critical webhook deliveries — are written
// here in the same transaction as the trigger event. A separate cron
// processor picks them up, runs the handler, and marks the row.
//
// `idempotencyKey` is a deterministic string per event (e.g.
// "order_confirmation:<orderId>"). The unique constraint guarantees
// a producer can't enqueue the same event twice; the processor uses
// (status, nextAttemptAt) to find work and updates row state to
// claim → succeed or back off.

enum OutboxEventStatus {
  pending      // newly enqueued or scheduled to retry
  running      // processor has claimed this row, in-flight
  succeeded    // handler completed successfully
  failed       // exceeded maxAttempts; needs human intervention
}

enum OutboxEventType {
  order_confirmation_email
  portal_access_email
  vr_project_ready_email
}

model OutboxEvent {
  id             String            @id @default(cuid())
  type           OutboxEventType
  payload        Json
  idempotencyKey String            @unique
  status         OutboxEventStatus @default(pending)
  attempts       Int               @default(0)
  maxAttempts    Int               @default(5)
  nextAttemptAt  DateTime          @default(now())
  lastError      String?           @db.Text
  createdAt      DateTime          @default(now())
  succeededAt    DateTime?

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model VrInquiry {
  id                String          @id @default(cuid())
  productId         String          // "vr-existing" | "vr-standalone"
  configJson        Json            // sanitized VrConfig
  contactName       String
  email             String
  phone             String?
  message           String?         @db.Text
  userId            String?         // set if a logged-in user submitted
  status            VrInquiryStatus @default(pending)
  // Set when an admin runs convertVrInquiryToOrder; references Order.id
  // without an FK so an order can be deleted without orphaning the
  // inquiry record.
  convertedOrderId  String?
  createdAt         DateTime        @default(now())
  reviewedAt        DateTime?

  @@index([status, createdAt])
  @@map("vr_inquiries")
}

# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxxx:PASSWORD@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# ─── Auth.js ──────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost:3000

# ─── Google OAuth ─────────────────────────────────────────
AUTH_GOOGLE_ID=xxxxx.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=GOCSPX-xxxxx

# ─── PayPal ───────────────────────────────────────────────
PAYPAL_CLIENT_ID=xxxxx
PAYPAL_CLIENT_SECRET=xxxxx
PAYPAL_MODE=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=xxxxx

# ─── Nestpay (Banca Intesa 3D Pay Hosting) ──────────────
# Card payments via Banca Intesa's Nestpay gateway. Test creds live in
# the Merchant Center (https://testsecurepay.eway2pay.com/bib/report/user.login).
# Production creds are issued by ecomm_podrska@bancaintesa.rs after
# successful test-card scenarios + checklist inspection.
#
# - MODE flips between "test" (HPP at testsecurepay.eway2pay.com) and
#   "live" (HPP at bib.eway2pay.com). NEXT_PUBLIC_ mirror controls UI
#   gating (the legacy card_mock option only shows in test).
# - CLIENT_ID is per-store, prefix "13IN…" in our case.
# - STORE_KEY is the merchant secret used only to compute the SHA-512
#   ver2 hash. Never sent in the POST body. Rotate ~every 3 months.
# - TRAN_TYPE: "Auth" = SMS (immediate capture, default). "PreAuth" = DMS
#   (authorize hold, capture later via Merchant Center).
# - OID_PREFIX is prepended to the Order.orderNumber when minting the
#   bank-facing oid (mintOid in src/lib/nestpay/oid.ts).
NEXT_PUBLIC_NESTPAY_MODE=test
NESTPAY_CLIENT_ID=13INxxxxxx
NESTPAY_STORE_KEY=your-test-store-key
NESTPAY_BASE_URL=https://testsecurepay.eway2pay.com/fim/est3Dgate
NESTPAY_QUERY_URL=https://testsecurepay.eway2pay.com/fim/api
NESTPAY_QUERY_USERNAME=
NESTPAY_QUERY_PASSWORD=
NESTPAY_TRAN_TYPE=Auth
NESTPAY_OID_PREFIX=ER-

# ─── Cloudflare Turnstile (anti-fraud captcha) ──────────
# Required by Banca Intesa EPM standards for guest checkouts; the payment
# step runs it consistently for every Nestpay initiation. Free tier at
# https://dash.cloudflare.com/?to=/:account/turnstile. Site key ships to
# the browser, secret stays server-only and is checked inside
# initiateNestpayPayment + the project inquiry server action.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ─── Bitrix24 ────────────────────────────────────────────
BITRIX24_WEBHOOK_URL=https://yourportal.bitrix24.com/rest/1/token/
BITRIX24_OUTBOUND_SECRET=your-outbound-webhook-token
BITRIX24_PIPELINE_ID=3
BITRIX24_STAGE_DRAFT=C3:NEW
BITRIX24_STAGE_AWAITING_PAYMENT=C3:AWAITING_PAYMENT
BITRIX24_STAGE_PAID=C3:PAID
BITRIX24_STAGE_IN_PROGRESS=C3:IN_PROGRESS
BITRIX24_STAGE_IN_REVIEW=C3:IN_REVIEW
BITRIX24_STAGE_REVISION_REQUESTED=C3:REVISION
BITRIX24_STAGE_DELIVERED=C3:DELIVERED
BITRIX24_STAGE_CLOSED=C3:CLOSED
BITRIX24_STAGE_CANCELLED=C3:CANCELLED
BITRIX24_STAGE_REFUNDED=C3:REFUNDED
CRON_SECRET=your-cron-secret

# ─── Email (Resend) ──────────────────────────────────────
# Get key at https://resend.com/api-keys (verify a sending domain first).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Elegant Render <noreply@elegantrender.rs>
ADMIN_NOTIFY_EMAIL=info@elegantrender.rs

# ─── Sentry (error tracking + tracing + session replay) ──
# DSN strings from sentry.io/settings/projects/<project>/keys/.
# Client-side DSN must be NEXT_PUBLIC_ to ship in browser bundle;
# server-side DSN stays server-only.
SENTRY_DSN=https://xxxxx@oxxx.ingest.de.sentry.io/xxxxxxx
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@oxxx.ingest.de.sentry.io/xxxxxxx

# Build-time auth token for source map upload (.env.sentry-build-plugin
# is gitignored; Vercel sets this in Production + Preview env). Without
# it, Sentry stack traces show minified code instead of TypeScript.
# Generate at https://sentry.io/settings/auth-tokens/ with scopes
# project:releases + org:read.
# SENTRY_AUTH_TOKEN=sntrys_xxxxx

# ─── Rate limiting (Upstash Redis REST) ─────────────────
# Backs sliding-window rate limiters on public write endpoints (VR
# inquiry submit, /poruci checkout, /api/checkout/upload-url, /api/chat).
# Without these set, the helpers no-op and let everything through —
# convenient for local dev, dangerous in production. Set both in Vercel.
# Get values at https://console.upstash.com/redis → your DB → REST API.
UPSTASH_REDIS_REST_URL=https://xxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxx

# ─── PostHog (product analytics + funnels) ──────────────
# Public project token from PostHog → Settings → General → Project
# token. Used by both the browser SDK (NEXT_PUBLIC_ prefix exposes it
# to the bundle) and posthog-node on the server.
# Region in the host: https://us.i.posthog.com (US Cloud) or
# https://eu.i.posthog.com (EU Cloud). Pick whichever matches the
# region you chose at PostHog signup.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ─── Google Analytics 4 (direct tag optional) ────────────
# Preferred setup: GA4 is configured inside Google Tag Manager below,
# so keep the direct GA4 tag disabled to avoid duplicate pageviews.
# NEXT_PUBLIC_GA4_MEASUREMENT_ID can still be set for admin readiness.
NEXT_PUBLIC_GA4_ENABLED=false
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-XXXXXXXXXX

# ─── Google Tag Manager (GA4 container) ──────────────────
# GTM loads only when enabled and after analytics consent. GA4 should
# fire from this container, not from both GTM and the direct GA4 tag.
NEXT_PUBLIC_GTM_ENABLED=false
NEXT_PUBLIC_GTM_CONTAINER_ID=GTM-XXXXXXX

# ─── Admin observability dashboard links ─────────────────
# Optional admin-only shortcuts shown at /portal/admin/analitika.
# These are URLs, not API secrets. Keep tokens/keys out of these values.
POSTHOG_DASHBOARD_URL=https://app.posthog.com/project/xxxxx
SENTRY_DASHBOARD_URL=https://sentry.io/organizations/xxxxx/projects/xxxxx/
VERCEL_WEB_ANALYTICS_URL=https://vercel.com/xxxxx/xxxxx/analytics
VERCEL_SPEED_INSIGHTS_URL=https://vercel.com/xxxxx/xxxxx/speed-insights
VERCEL_PROJECT_DASHBOARD_URL=https://vercel.com/xxxxx/xxxxx
GOOGLE_SEARCH_CONSOLE_URL=https://search.google.com/search-console
GOOGLE_ANALYTICS_DASHBOARD_URL=https://analytics.google.com/analytics/web/
GOOGLE_TAG_MANAGER_DASHBOARD_URL=https://tagmanager.google.com/
BING_WEBMASTER_URL=https://www.bing.com/webmasters

# ─── Search Console verification ─────────────────────────
# Use the content value from the Google HTML tag verification method:
# <meta name="google-site-verification" content="...">
# Prefer DNS TXT verification when DNS access is available.
GOOGLE_SITE_VERIFICATION=

# ─── AI Studio ───────────────────────────────────────────
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
# Legacy provider fallback only. New AI Studio jobs use the engine catalog
# (Nano Banana Pro, Nano Banana, GPT Image 1.5, GPT Image 2 test) and store
# the exact model on the generation.
AI_STUDIO_OPENAI_MODEL=gpt-image-2
AI_STUDIO_GEMINI_MODEL=gemini-2.5-flash-image
AI_STUDIO_GEMINI_PRO_MODEL=gemini-3-pro-image-preview

# Cloudmersive Virus Scan API — antivirus scan for client uploads.
# Required by src/lib/file-scan.ts. Without this, upload confirmation
# returns "scan unavailable" and refuses the file.
# Sign up at https://www.cloudmersive.com (free tier 800 scans/month)
# → Account → API Keys.
CLOUDMERSIVE_API_KEY=
